#!/usr/bin/env python3
"""Resolve which Chrome tab is capturing the microphone (best effort).

Chrome's PipeWire capture stream carries no tab identity, so this reads Chrome's
own WebRTC internals over the DevTools protocol instead.

Requirements:
  * Chrome started with --remote-debugging-port=PORT (the port is also picked up
    from CHROME_DEVTOOLS_PORT or <profile>/DevToolsActivePort).
  * If chrome://webrtc-internals is not already open, it is opened in a
    background tab (it does not steal focus) so its getUserMedia log can be read.

Prints one JSON object on stdout:
  {"tabs": [{"title": .., "url": ..}], "origins": [..]}   on success
  {"error": "no-devtools-port" | "connect-failed" | ..}   otherwise
"""
import base64, json, os, socket, struct, sys, time, urllib.parse, urllib.request

PROFILE_DIRS = ("~/.config/google-chrome", "~/.config/google-chrome-beta",
                "~/.config/chromium", "~/.config/chromium-browser")
INTERNALS_URL = "chrome://webrtc-internals/"


def find_port():
    env = os.environ.get("CHROME_DEVTOOLS_PORT")
    if env and env.strip().isdigit():
        return int(env)
    for directory in PROFILE_DIRS:
        path = os.path.expanduser(directory + "/DevToolsActivePort")
        if os.path.exists(path):
            try:
                with open(path) as handle:
                    line = handle.readline().strip()
                if line.isdigit():
                    return int(line)
            except OSError:
                pass
    return None


def http_json(port, path, method="GET"):
    request = urllib.request.Request("http://127.0.0.1:%d%s" % (port, path), method=method)
    with urllib.request.urlopen(request, timeout=3) as response:
        body = response.read().decode("utf-8", "replace")
    return json.loads(body) if body.strip() else {}


def _recvn(sock, count):
    out = b""
    while len(out) < count:
        chunk = sock.recv(count - len(out))
        if not chunk:
            break
        out += chunk
    return out


def ws_send(sock, obj):
    data = json.dumps(obj).encode()
    header = bytearray([0x81])
    size = len(data)
    if size < 126:
        header.append(0x80 | size)
    elif size < 65536:
        header.append(0x80 | 126); header += struct.pack(">H", size)
    else:
        header.append(0x80 | 127); header += struct.pack(">Q", size)
    mask = os.urandom(4)
    header += mask
    sock.sendall(bytes(header) + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))


def ws_recv(sock):
    header = _recvn(sock, 2)
    if len(header) < 2:
        return None, b""
    opcode = header[0] & 0x0F
    length = header[1] & 0x7F
    if length == 126:
        length = struct.unpack(">H", _recvn(sock, 2))[0]
    elif length == 127:
        length = struct.unpack(">Q", _recvn(sock, 8))[0]
    return opcode, _recvn(sock, length)


class Cdp:
    def __init__(self, ws_url, timeout=6):
        rest = ws_url[len("ws://"):]
        hostport, _, path = rest.partition("/")
        host, _, port = hostport.partition(":")
        self.sock = socket.create_connection((host, int(port)), timeout=timeout)
        self.next_id = 0
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall(("GET /%s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\n"
                           "Connection: Upgrade\r\nSec-WebSocket-Key: %s\r\n"
                           "Sec-WebSocket-Version: 13\r\n\r\n"
                           % (path, hostport, key)).encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise RuntimeError("websocket handshake failed")
            buf += chunk
        self.timeout = timeout

    def call(self, method, params=None):
        self.next_id += 1
        request_id = self.next_id
        ws_send(self.sock, {"id": request_id, "method": method, "params": params or {}})
        deadline = time.time() + self.timeout
        while time.time() < deadline:
            opcode, payload = ws_recv(self.sock)
            if opcode is None or opcode == 0x8:
                return None
            if opcode != 0x1:
                continue
            try:
                message = json.loads(payload)
            except ValueError:
                continue
            if message.get("id") == request_id:
                return message
        return None

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def ensure_internals(port, targets):
    existing = next((t for t in targets if str(t.get("url", "")).startswith("chrome://webrtc-internals")), None)
    if existing:
        return targets
    try:
        version = http_json(port, "/json/version")
        browser_ws = version.get("webSocketDebuggerUrl")
        if browser_ws:
            browser = Cdp(browser_ws)
            browser.call("Target.createTarget", {"url": INTERNALS_URL, "background": True})
            browser.close()
            time.sleep(1.5)
            return http_json(port, "/json")
    except Exception:  # noqa: BLE001
        pass
    return targets


def main():
    port = find_port()
    if not port:
        print(json.dumps({"error": "no-devtools-port"}))
        return 0
    try:
        targets = http_json(port, "/json")
    except Exception as exc:  # noqa: BLE001
        print(json.dumps({"error": "connect-failed", "detail": str(exc)}))
        return 0
    if not isinstance(targets, list):
        print(json.dumps({"error": "bad-target-list"}))
        return 0

    targets = ensure_internals(port, targets)
    internals = next((t for t in targets if str(t.get("url", "")).startswith("chrome://webrtc-internals")), None)
    if internals is None:
        print(json.dumps({"error": "no-webrtc-internals"}))
        return 0

    client = Cdp(internals["webSocketDebuggerUrl"])
    expression = ("JSON.stringify(Array.from(document.querySelectorAll("
                  "'#user-media-tab-id > div')).map(function(d){return d.innerText||''}))")
    response = client.call("Runtime.evaluate", {"expression": expression, "returnByValue": True})
    client.close()
    raw = (((response or {}).get("result") or {}).get("result") or {}).get("value") or "[]"
    try:
        entries = json.loads(raw)
    except ValueError:
        entries = []

    origins = []
    for entry in entries:
        if "getUserMedia result" not in entry or "error" in entry.lower():
            continue
        for line in entry.splitlines():
            line = line.strip()
            if line.startswith("Caller origin:"):
                origin = line.split(":", 1)[1].strip()
                if origin and origin not in origins:
                    origins.append(origin)

    tabs, seen = [], set()
    for target in targets:
        if target.get("type") != "page":
            continue
        url = str(target.get("url", ""))
        if url.startswith("chrome://") or url.startswith("devtools://"):
            continue
        for origin in origins:
            if url.startswith(origin) or origin.startswith(url):
                if url not in seen:
                    seen.add(url)
                    tabs.append({"title": target.get("title") or url, "url": url})
                break

    print(json.dumps({"tabs": tabs, "origins": origins}))
    return 0


if __name__ == "__main__":
    sys.exit(main())

